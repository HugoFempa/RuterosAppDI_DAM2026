<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- =========================================================
         Proyecto
         ========================================================= -->
    <groupId>es.fempa</groupId>
    <artifactId>ruteros</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <!-- =========================================================
         Propiedades
         ========================================================= -->
    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <jakarta.faces.version>4.1.4</jakarta.faces.version>
        <primefaces.version>15.0.9</primefaces.version>
        <weld.version>6.0.3.Final</weld.version>
    </properties>

    <!-- =========================================================
         Dependencias
         ========================================================= -->
    <dependencies>

        <!--
            Jakarta Servlet 6.1
            Tomcat 11 ya proporciona esta API, por eso es "provided".
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.1.0</version>
            <scope>provided</scope>
        </dependency>


        <!-- =====================================================
             Jakarta Faces / Mojarra

             Tomcat NO incluye Jakarta Faces, por lo que debe
             incluirse dentro del WAR.
             ===================================================== -->
        <dependency>
            <groupId>org.glassfish</groupId>
            <artifactId>jakarta.faces</artifactId>
            <version>${jakarta.faces.version}</version>
        </dependency>


        <!-- =====================================================
             PrimeFaces para Jakarta
             ===================================================== -->
        <dependency>
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces</artifactId>
            <version>${primefaces.version}</version>
            <classifier>jakarta</classifier>
        </dependency>


        <!-- =====================================================
             CDI / Weld

             Tomcat NO implementa CDI.
             Weld proporciona la implementación CDI.
             ===================================================== -->
        <dependency>
            <groupId>org.jboss.weld.servlet</groupId>
            <artifactId>weld-servlet-shaded</artifactId>
            <version>${weld.version}</version>
        </dependency>

    </dependencies>


    <!-- =========================================================
         Build
         ========================================================= -->
    <build>

        <!-- Nombre final del WAR -->
        <finalName>ruteros</finalName>

        <plugins>

            <!-- =================================================
                 Compilador Java
                 ================================================= -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>

                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>


            <!-- =================================================
                 Generación del WAR
                 ================================================= -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>

                <configuration>

                    <!-- Permite aplicaciones sin web.xml -->
                    <failOnMissingWebXml>false</failOnMissingWebXml>

                </configuration>
            </plugin>

        </plugins>

    </build>

    <profiles>
        <profile>
            <id>deploy-local</id>

            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.2.0</version>

                        <executions>
                            <execution>
                                <id>deploy-to-tomcat</id>
                                <phase>install</phase>

                                <configuration>
                                    <target>
                                        <copy
                                            file="${project.build.directory}/${project.build.finalName}.war"
                                            todir="C:/apache-tomcat-11.0.27/webapps"
                                            overwrite="true"
                                        />
                                    </target>
                                </configuration>

                                <goals>
                                    <goal>run</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

    <profile>
    <id>deploy-web</id>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>

                <executions>

                    <execution>
                        <id>copy-web-resources-to-tomcat</id>

                        <phase>process-resources</phase>

                        <goals>
                            <goal>copy-resources</goal>
                        </goals>

                        <configuration>

                            <!-- Aplicación expandida en Tomcat -->
                            <outputDirectory>
                                ${env.CATALINA_HOME}/webapps/${project.build.finalName}
                            </outputDirectory>

                            <resources>

                                <resource>
                                    <directory>
                                        ${project.basedir}/src/main/webapp
                                    </directory>

                                    <filtering>false</filtering>

                                    <includes>
                                        <include>**/*.xhtml</include>
                                        <include>**/*.css</include>
                                    </includes>

                                </resource>

                            </resources>

                            <overwrite>true</overwrite>

                        </configuration>

                    </execution>

                </executions>

            </plugin>

        </plugins>
    </build>

</profile>
</profiles>

</project>